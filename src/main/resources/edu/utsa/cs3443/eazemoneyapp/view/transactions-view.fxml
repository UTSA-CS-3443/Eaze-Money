<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.eazemoneyapp.controller.TransactionsController"
      spacing="16"
      fillWidth="true"
      styleClass="transactions-page">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Transactions"
                   styleClass="page-title"/>
            <Label text="View and manage your financial activity"
                   style="-fx-text-fill: #888888;"/>
        </VBox>

        <Button text="+ Add Transaction"
                fx:id="addTransactionButton"
                styleClass="button-primary"/>

        <Button text="Edit Selected"
                fx:id="editTransactionButton"
                styleClass="button-secondary"/>

        <Button text="Delete Selected"
                fx:id="deleteTransactionButton"
                styleClass="button-secondary"/>
    </HBox>

    <!-- Transactions table -->
    <TableView fx:id="transactionsTable"
               VBox.vgrow="ALWAYS">

        <styleClass>
            <String fx:value="table-view"/>
            <String fx:value="transactions-table"/>
        </styleClass>

        <placeholder>
            <Label text="No transactions yet. Add one to get started!"
                   style="-fx-text-fill: #6B7380; -fx-font-size: 14px;"/>
        </placeholder>

        <columns>
            <TableColumn fx:id="dateColumn"
                         text="Date"
                         prefWidth="110"/>

            <TableColumn fx:id="transactionColumn"
                         text="Transaction"
                         prefWidth="160"/>

            <TableColumn fx:id="categoryColumn"
                         text="Category"
                         prefWidth="120"/>

            <TableColumn fx:id="walletColumn"
                         text="Wallet"
                         prefWidth="120"/>



            <TableColumn fx:id="amountColumn"
                         text="Amount"
                         prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
