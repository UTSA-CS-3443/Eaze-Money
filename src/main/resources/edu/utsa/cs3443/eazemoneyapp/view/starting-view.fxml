<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" styleClass="landing" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.eazemoneyapp.controller.LandingController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="12.0" styleClass="landing-topbar" BorderPane.alignment="CENTER_LEFT">
         <children>
            <ImageView fitHeight="32.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/logo.png" />
               </image>
            </ImageView>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onLogin" styleClass="button-secondary" text="Sign in" />
         </children>
      </HBox>
   </top>
   <center>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="56.0" styleClass="landing-hero" BorderPane.alignment="CENTER_RIGHT">
         <children>
            <VBox alignment="CENTER" maxWidth="520.0" prefHeight="200.0" prefWidth="100.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="landing-tag" text="Free. Works offline. Data stays  on your computer" />
                  <Label styleClass="landing-headline" text="Know where every dollar goes" wrapText="true" />
                  <Label styleClass="landing-subtitle" text="Track spending across all your wallets, set monthly limits, and see your progress at a glance — all in one window." />
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="12.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onRegister" styleClass="button-primary" text="Get Started" />
                        <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onLogin" styleClass="button-secondary" text="SIgn in" />
                     </children>
                  </HBox>
                  <Label styleClass="landing-note" text="No bank login needed. Everything is saved as local files you control." wrapText="true" />
               </children>
            </VBox>
            <ImageView fx:id="previewImage" fitHeight="567.0" fitWidth="908.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/dashboard-preview.png" />
               </image>
            </ImageView>
         </children>
      </HBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="16.0" styleClass="landing-footer" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="landing-note" text="© 2026 Eaze Money · CS3443 project" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Hyperlink onAction="#onTerms" text="Terms of Service" />
            <Hyperlink onAction="#onPrivacy" text="Privacy Policy" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
