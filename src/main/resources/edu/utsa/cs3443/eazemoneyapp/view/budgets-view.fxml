<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.eazemoneyapp.controller.BudgetsController"
      alignment="CENTER" spacing="10.0"
      prefHeight="400.0" prefWidth="600.0">
    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
    </padding>

    <VBox spacing="10.0" maxWidth="360.0">
        <Label text="Add Budget" styleClass="page-title" />

        <Label text="Budget name" />
        <TextField fx:id="nameField" promptText="e.g. Groceries Budget" />

        <Label text="Category" />
        <TextField fx:id="categoryField" promptText="e.g. GROCERIES" />

        <Label text="Amount" />
        <TextField fx:id="amountField" promptText="e.g. 250.00" />

        <Label text="Period" />
        <ComboBox fx:id="periodBox" maxWidth="Infinity" />

        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10.0" />
            </padding>
            <Button text="Back to Dashboard" styleClass="button-secondary" onAction="#onBack" cancelButton="true" />
            <Button text="Save Budget" styleClass="button-primary" onAction="#onSave" defaultButton="true" />
        </HBox>
    </VBox>
</VBox>
