<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.eazemoneyapp.controller.BudgetsController"
      spacing="20" fillWidth="true">
    <padding>
        <Insets top="25" right="30" bottom="25" left="30" />
    </padding>

    <!-- Header with the Create / Update / Delete buttons -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Budgets" styleClass="page-title" />
            <Label text="Spending is counted for the current week, month or year of each budget"
                   style="-fx-text-fill: #888888;" wrapText="true" />
        </VBox>
        <Button fx:id="editButton" text="Edit" styleClass="button-secondary" onAction="#onEdit" minWidth="-Infinity" />
        <Button fx:id="deleteButton" text="Delete" styleClass="button-secondary" onAction="#onDelete" minWidth="-Infinity" />
        <Button text="+ Add Budget" styleClass="button-primary" onAction="#onAdd" minWidth="-Infinity" />
    </HBox>

    <!-- Current budgets (select a row, then Edit or Delete; double-click a row to edit) -->
    <TableView fx:id="budgetsTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="No budgets yet. Click &quot;+ Add Budget&quot; to create one." />
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameColumn" text="Budget" prefWidth="160" />
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120" />
            <TableColumn fx:id="periodColumn" text="Period" prefWidth="90" />
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="90" />
            <TableColumn fx:id="spentColumn" text="Spent" prefWidth="90" />
            <TableColumn fx:id="remainingColumn" text="Remaining" prefWidth="100" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
        </columns>
    </TableView>
</VBox>
